# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored -- never put real credentials in any other file.
#
# Nothing in Phase 1 needs these. They are here for Phase 2 (eBay Browse API),
# which uses a free standard eBay developer account.

# From developer.ebay.com -> your application keyset (Production).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# "PRODUCTION" or "SANDBOX"
EBAY_ENV=PRODUCTION

# Marketplace to search. EBAY_US for the United States.
EBAY_MARKETPLACE_ID=EBAY_US
